<mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="880" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="OV streaming pipeline — architectuur" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="900" height="28" as="geometry"/></mxCell>
<mxCell id="sub" value="Van twee GTFS-realtime feeds naar live delay-aggregaten: Kafka als bus, een windowed processor, MinIO als replaybaar archief, Postgres als serving-laag — dertien containers, volledig lokaal." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1200" height="20" as="geometry"/></mxCell>
<mxCell id="feed" value="OVapi GTFS-RT&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;br&gt;vehiclePositions.pb&lt;br&gt;elke 20 s&lt;br&gt;&lt;br&gt;tripUpdates.pb&lt;br&gt;elke 60 s&lt;br&gt;&lt;br&gt;FULL_DATASET snapshots,&lt;br&gt;ververst ~1× per minuut&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#8c8c8c;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="190" height="220" as="geometry"/></mxCell>
<mxCell id="prod" value="producer&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;br&gt;protobuf parsen&lt;br&gt;snapshot diffen&lt;br&gt;+ heartbeat per 60 s&lt;br&gt;&lt;br&gt;backoff op HTTP 429&lt;br&gt;ghost-posities weggooien&lt;br&gt;&lt;br&gt;~45% van de entiteiten&lt;br&gt;wordt onderdrukt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#7a5c00;" vertex="1" parent="1"><mxGeometry x="280" y="100" width="200" height="220" as="geometry"/></mxCell>
<mxCell id="kafka" value="REDPANDA (Kafka-API)" style="swimlane;rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=11;startSize=26;html=1;" vertex="1" parent="1"><mxGeometry x="530" y="100" width="240" height="300" as="geometry"/></mxCell>
<mxCell id="t1" value="vehicle_positions&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;6 partities · key = vehicle_id&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;fontStyle=1;" vertex="1" parent="kafka"><mxGeometry x="20" y="38" width="200" height="66" as="geometry"/></mxCell>
<mxCell id="t2" value="arrival_predictions&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;6 partities · key = trip_id&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;fontStyle=1;" vertex="1" parent="kafka"><mxGeometry x="20" y="116" width="200" height="66" as="geometry"/></mxCell>
<mxCell id="t3" value="dlq.vehicle_positions&lt;br&gt;dlq.arrival_predictions&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;originele bytes + error-headers&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="kafka"><mxGeometry x="20" y="194" width="200" height="74" as="geometry"/></mxCell>
<mxCell id="t4" value="retentie 24 u (DLQ 7 d) — de broker is een buffer, geen archief" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#8a6400;fontStyle=2;" vertex="1" parent="kafka"><mxGeometry x="20" y="270" width="200" height="26" as="geometry"/></mxCell>
<mxCell id="proc" value="processor&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;br&gt;tumbling windows van 5 min&lt;br&gt;per-partitie watermarks&lt;br&gt;2 min toegestane vertraging&lt;br&gt;&lt;br&gt;count · mean · P90 · max · min&lt;br&gt;over 4 dimensies:&lt;br&gt;lijn · station · vervoerder · netwerk&lt;br&gt;&lt;br&gt;manual commit, ná de upsert&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=3;fontSize=12;fontStyle=1;fontColor=#2d4b73;" vertex="1" parent="1"><mxGeometry x="820" y="100" width="240" height="240" as="geometry"/></mxCell>
<mxCell id="arch" value="archiver&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;br&gt;eigen consumer group&lt;br&gt;ruwe bytes, gzip JSON-lines&lt;br&gt;commit pas na een&lt;br&gt;geslaagde put&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#3d6b2e;" vertex="1" parent="1"><mxGeometry x="820" y="400" width="240" height="140" as="geometry"/></mxCell>
<mxCell id="minio" value="MinIO — raw-events&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;topic/date/hour/p-offsets.jsonl.gz&lt;br&gt;&lt;br&gt;het replaybare langetermijnarchief&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#3d6b2e;" vertex="1" parent="1"><mxGeometry x="530" y="420" width="240" height="120" as="geometry"/></mxCell>
<mxCell id="pg" value="POSTGRES" style="swimlane;rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;startSize=26;html=1;" vertex="1" parent="1"><mxGeometry x="1110" y="100" width="250" height="300" as="geometry"/></mxCell>
<mxCell id="p1" value="delay_aggregates&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;PK = (window_start, dimension,&lt;br&gt;dimension_id) — de idempotentiesleutel&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;fontSize=11;fontStyle=1;" vertex="1" parent="pg"><mxGeometry x="15" y="38" width="220" height="66" as="geometry"/></mxCell>
<mxCell id="p2" value="vehicle_latest · trip_delay_latest&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;last-write-wins, bewaakt door observed_at&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="pg"><mxGeometry x="15" y="116" width="220" height="60" as="geometry"/></mxCell>
<mxCell id="p3" value="ref_agencies · ref_routes&lt;br&gt;ref_stops · ref_trips&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;statische GTFS-referentie&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="pg"><mxGeometry x="15" y="188" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="p4" value="alle tijden in UTC" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#5f3d73;fontStyle=2;" vertex="1" parent="pg"><mxGeometry x="15" y="262" width="220" height="24" as="geometry"/></mxCell>
<mxCell id="gtfs" value="gtfs-static&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;220 MB zip rechtstreeks in COPY&lt;br&gt;staging + atomische swap&lt;br&gt;dagelijks — 864k trips, 76k stops&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#5f3d73;" vertex="1" parent="1"><mxGeometry x="1110" y="430" width="250" height="110" as="geometry"/></mxCell>
<mxCell id="dash" value="dashboard (Streamlit + pydeck)&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;live kaart · KPI-tegels · slechtste lijnen en stations · netwerktrend · verdeling · health-strip — ververst elke 10 s&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1040" y="600" width="320" height="110" as="geometry"/></mxCell>
<mxCell id="obs" value="OBSERVABILITY — Prometheus scrapet elke service én Redpanda; Grafana levert een geprovisioneerd dashboard van 26 panelen: throughput · consumer lag · watermark lag · DLQ-rate · late events · verwerkingstijd · state size · archiefvolume" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#9a3b37;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="1320" height="80" as="geometry"/></mxCell>
<mxCell id="replaybox" value="REPLAY — make replay FROM= TO= draait archiefbestanden opnieuw door dezelfde Pipeline-klasse als de consumer (geen tweede implementatie), gededupliceerd op (topic, partitie, offset).&lt;br&gt;make replay-dlq decodeert dode brieven met de huidige parser en injecteert de gerepareerde terug in het brononderwerp." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;strokeWidth=1;dashed=1;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="960" height="110" as="geometry"/></mxCell>
