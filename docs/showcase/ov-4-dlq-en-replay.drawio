<mxGraphModel dx="1300" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="700" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Als het misgaat: dode brieven en replay" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="900" height="28" as="geometry"/></mxCell>
<mxCell id="sub" value="Niets blokkeert de hoofdlus. Wat niet verwerkt kan worden gaat opzij met genoeg context om het later alsnog te doen — en replay draait door dezelfde code als de live pipeline." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1200" height="20" as="geometry"/></mxCell>
<mxCell id="dlqp" value="DODE BRIEVEN" style="swimlane;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;startSize=30;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="620" height="540" as="geometry"/></mxCell>
<mxCell id="d1" value="producer — parse-fout&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;voertuig zonder positie · zonder trip-id&lt;br&gt;coördinaten op (0, 0)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#7a5c00;" vertex="1" parent="dlqp"><mxGeometry x="20" y="44" width="280" height="62" as="geometry"/></mxCell>
<mxCell id="d2" value="processor — decode-fout&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;onbekende schemaversie → SchemaError&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#2d4b73;" vertex="1" parent="dlqp"><mxGeometry x="320" y="44" width="280" height="62" as="geometry"/></mxCell>
<mxCell id="d3" value="dlq.&amp;lt;source_topic&amp;gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;br&gt;de &lt;b&gt;originele bytes&lt;/b&gt;, met headers:&lt;br&gt;stage · source_topic · source_partition · source_offset&lt;br&gt;error · failed_at · schema_version&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=3;fontSize=12;fontStyle=1;fontColor=#9a3b37;" vertex="1" parent="dlqp"><mxGeometry x="150" y="140" width="320" height="110" as="geometry"/></mxCell>
<mxCell id="d4" value="zichtbaar binnen 10 s&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;make dlq-peek · Grafana DLQ-paneel · health-strip&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" vertex="1" parent="dlqp"><mxGeometry x="20" y="280" width="270" height="58" as="geometry"/></mxCell>
<mxCell id="d5" value="elke (entiteit, reden) één keer&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;de feed stuurt dezelfde kapotte entiteit&lt;br&gt;elke minuut opnieuw&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" vertex="1" parent="dlqp"><mxGeometry x="320" y="280" width="280" height="58" as="geometry"/></mxCell>
<mxCell id="d6" value="make replay-dlq&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;draait de mislukte stap opnieuw met de huidige code&lt;br&gt;(een parserfix, een nieuwe schemaversie)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;fontSize=12;fontStyle=1;fontColor=#8a6400;" vertex="1" parent="dlqp"><mxGeometry x="150" y="366" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="d7" value="gelukt → terug op het brononderwerp&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;met header replayed_from&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=11;fontColor=#3d6b2e;" vertex="1" parent="dlqp"><mxGeometry x="20" y="462" width="270" height="58" as="geometry"/></mxCell>
<mxCell id="d8" value="nog steeds stuk → blijft staan&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;samengevat per reden&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#8c8c8c;fontSize=11;fontColor=#555555;" vertex="1" parent="dlqp"><mxGeometry x="320" y="462" width="280" height="58" as="geometry"/></mxCell>
<mxCell id="rep" value="REPLAY UIT HET ARCHIEF" style="swimlane;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;startSize=30;html=1;" vertex="1" parent="1"><mxGeometry x="700" y="100" width="580" height="540" as="geometry"/></mxCell>
<mxCell id="r1" value="MinIO — raw-events&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;topic/date/hour/p-offsets.jsonl.gz&lt;br&gt;bestandsnamen dragen het exacte offsetbereik&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#3d6b2e;" vertex="1" parent="rep"><mxGeometry x="130" y="44" width="320" height="90" as="geometry"/></mxCell>
<mxCell id="r2" value="make replay FROM=… TO=…" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;fontSize=13;fontStyle=1;fontColor=#8a6400;" vertex="1" parent="rep"><mxGeometry x="130" y="164" width="320" height="50" as="geometry"/></mxCell>
<mxCell id="r3" value="dezelfde Pipeline-klasse als de consumer&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;replay is geen tweede implementatie — anders&lt;br&gt;test je twee dingen en vertrouw je er één&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=3;fontSize=12;fontStyle=1;fontColor=#2d4b73;" vertex="1" parent="rep"><mxGeometry x="130" y="244" width="320" height="76" as="geometry"/></mxCell>
<mxCell id="r4" value="dedupe op (topic, partitie, offset)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="rep"><mxGeometry x="20" y="350" width="255" height="50" as="geometry"/></mxCell>
<mxCell id="r5" value="deels gedekt venster wordt overgeslagen&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;--include-partial om te overrulen&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="rep"><mxGeometry x="300" y="350" width="255" height="50" as="geometry"/></mxCell>
