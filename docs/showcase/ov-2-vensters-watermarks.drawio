<mxCell id="pw1" value="p1 &amp;nbsp;·&amp;nbsp; max event time 10:13:05" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="wmbox"><mxGeometry x="20" y="80" width="300" height="34" as="geometry"/></mxCell>
<mxCell id="pw2" value="&lt;b&gt;p2 &amp;nbsp;·&amp;nbsp; max event time 10:12:40&lt;/b&gt; &amp;nbsp; ← traagste" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="wmbox"><mxGeometry x="20" y="120" width="300" height="34" as="geometry"/></mxCell>
<mxCell id="pw3" value="p3 &amp;nbsp;·&amp;nbsp; max event time 10:13:12" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="wmbox"><mxGeometry x="20" y="160" width="300" height="34" as="geometry"/></mxCell>
<mxCell id="pw4" value="p4 &amp;nbsp;·&amp;nbsp; max event time 10:13:08" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="wmbox"><mxGeometry x="20" y="200" width="300" height="34" as="geometry"/></mxCell>
<mxCell id="pw5" value="p5 &amp;nbsp;·&amp;nbsp; &lt;i&gt;stil sinds 130 s → buiten beschouwing&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#8c8c8c;fontSize=11;align=left;spacingLeft=12;dashed=1;fontColor=#777777;" vertex="1" parent="wmbox"><mxGeometry x="20" y="240" width="300" height="34" as="geometry"/></mxCell>
<mxCell id="calc" value="min = 10:12:40&amp;nbsp;&amp;nbsp;−&amp;nbsp;&amp;nbsp;120 s toegestane vertraging&lt;br&gt;&lt;b&gt;watermark = 10:10:40&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=12;fontColor=#9a3b37;" vertex="1" parent="wmbox"><mxGeometry x="20" y="288" width="300" height="62" as="geometry"/></mxCell>
<mxCell id="tl" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#cccccc;dashed=1;" vertex="1" parent="1"><mxGeometry x="430" y="100" width="830" height="380" as="geometry"/></mxCell>
<mxCell id="tlt" value="EVENT-TIME AS" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="450" y="112" width="300" height="24" as="geometry"/></mxCell>
<mxCell id="w1" value="10:00 – 10:05&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;br&gt;GEFINALISEERD&lt;br&gt;weggeschreven en vergeten&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#3d6b2e;" vertex="1" parent="1"><mxGeometry x="450" y="160" width="190" height="120" as="geometry"/></mxCell>
<mxCell id="w2" value="10:05 – 10:10&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;br&gt;GEFINALISEERD&lt;br&gt;window_end ≤ watermark&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=3;fontSize=12;fontStyle=1;fontColor=#3d6b2e;" vertex="1" parent="1"><mxGeometry x="650" y="160" width="190" height="120" as="geometry"/></mxCell>
<mxCell id="w3" value="10:10 – 10:15&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;br&gt;OPEN&lt;br&gt;accumuleert nog&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#7a5c00;" vertex="1" parent="1"><mxGeometry x="850" y="160" width="190" height="120" as="geometry"/></mxCell>
<mxCell id="w4" value="10:15 – 10:20&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;br&gt;OPEN&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#7a5c00;dashed=1;" vertex="1" parent="1"><mxGeometry x="1050" y="160" width="190" height="120" as="geometry"/></mxCell>
<mxCell id="wmline" value="" style="endArrow=none;html=1;strokeColor=#b85450;strokeWidth=3;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="875" y="140" as="sourcePoint"/><mxPoint x="875" y="400" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="wmlabel" value="watermark 10:10:40" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#9a3b37;" vertex="1" parent="1"><mxGeometry x="790" y="118" width="170" height="20" as="geometry"/></mxCell>
<mxCell id="late" value="event met event-time 10:07&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;arriveert nú — maar zijn venster is al gefinaliseerd&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontSize=11;fontColor=#9a3b37;" vertex="1" parent="1"><mxGeometry x="450" y="330" width="290" height="60" as="geometry"/></mxCell>
<mxCell id="latex" value="LATE&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;geteld en weggegooid&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#9a3b37;" vertex="1" parent="1"><mxGeometry x="790" y="330" width="150" height="60" as="geometry"/></mxCell>
<mxCell id="lateedge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="late" target="latex"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="axis" value="" style="endArrow=classic;html=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="430" as="sourcePoint"/><mxPoint x="1240" y="430" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="axisl" value="event time →" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#666666;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1130" y="440" width="120" height="20" as="geometry"/></mxCell>
<mxCell id="n1" value="&lt;b&gt;Waarom per partitie en niet globaal.&lt;/b&gt; De eerste versie nam één globaal maximum. Tijdens een inhaalslag van veertig minuten liepen de zes partities uiteen en werden 169.000 volstrekt normale events als 'te laat' bestempeld. Per-partitie watermarks — wat Flink ook doet — losten dat op." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="590" height="90" as="geometry"/></mxCell>
<mxCell id="n2" value="&lt;b&gt;Waarom een stille partitie niet meetelt.&lt;/b&gt; Zonder idle-timeout houdt één zwijgende partitie de watermark voor altijd tegen en sluit er nooit meer een venster. Na 120 s stilte telt een partitie niet meer mee, tot ze weer iets stuurt." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="670" y="520" width="590" height="90" as="geometry"/></mxCell>
<mxCell id="n3" value="&lt;b&gt;En als het hele land stilvalt.&lt;/b&gt; Tussen 01:00 en 05:00 rijden er twintig à dertig nachtbussen. Na 90 s zonder events schuift de processor de watermark op de wandklok vooruit, zodat het laatste venster van de nacht alsnog sluit." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="590" height="80" as="geometry"/></mxCell>
<mxCell id="n4" value="&lt;b&gt;Wat er per venster uit komt.&lt;/b&gt; count, gemiddelde, exacte P90 (nearest-rank), max en min — per lijn, per station, per vervoerder en voor het hele netwerk. In de ochtendspits zijn dat 2.739 vensters per vijf minuten." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="670" y="630" width="590" height="80" as="geometry"/></mxCell>
</root></mxGraphModel>
