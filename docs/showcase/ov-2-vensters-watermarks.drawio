<mxCell id="title" value="Vensters, watermarks en late events" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="900" height="28" as="geometry"/></mxCell>
<mxCell id="sub" value="Tumbling vensters van 5 minuten, uitgelijnd op het epoch. Een venster sluit zodra de watermark het einde bereikt — en die watermark komt van de traagste partitie, niet van de snelste." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1200" height="20" as="geometry"/></mxCell>
<mxCell id="wmbox" value="DE WATERMARK — min over actieve partities" style="swimlane;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;startSize=30;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="340" height="380" as="geometry"/></mxCell>
