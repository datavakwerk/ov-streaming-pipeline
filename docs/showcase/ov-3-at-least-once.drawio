<mxCell id="s3" value="3 · watermark bijwerken → welke vensters sluiten?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="seq"><mxGeometry x="20" y="154" width="320" height="46" as="geometry"/></mxCell>
<mxCell id="s4" value="4 · UPSERT gefinaliseerde vensters in Postgres&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;+ last-write-wins state, bewaakt door observed_at&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=3;fontSize=11;fontStyle=1;fontColor=#5f3d73;" vertex="1" parent="seq"><mxGeometry x="20" y="210" width="320" height="60" as="geometry"/></mxCell>
