<mxCell id="s6" value="6 · COMMIT offsets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=3;fontSize=12;fontStyle=1;fontColor=#3d6b2e;" vertex="1" parent="seq"><mxGeometry x="20" y="336" width="320" height="50" as="geometry"/></mxCell>
<mxCell id="s7" value="Stap 4 vóór stap 6. Altijd." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#2d4b73;fontStyle=2;" vertex="1" parent="seq"><mxGeometry x="20" y="396" width="320" height="30" as="geometry"/></mxCell>
<mxCell id="led" value="DE OFFSET-LEDGER, PER PARTITIE" style="swimlane;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;startSize=30;html=1;" vertex="1" parent="1"><mxGeometry x="440" y="100" width="440" height="450" as="geometry"/></mxCell>
<mxCell id="lhdr" value="(offset, window_end) in aankomstvolgorde" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8a6400;fontStyle=2;spacingLeft=8;" vertex="1" parent="led"><mxGeometry x="20" y="36" width="400" height="22" as="geometry"/></mxCell>
<mxCell id="l1" value="offset 100 &amp;nbsp;·&amp;nbsp; venster eindigt 10:05 &amp;nbsp;·&amp;nbsp; &lt;b&gt;gefinaliseerd&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="led"><mxGeometry x="20" y="64" width="400" height="38" as="geometry"/></mxCell>
<mxCell id="l2" value="offset 101 &amp;nbsp;·&amp;nbsp; positie (geen venster) &amp;nbsp;·&amp;nbsp; &lt;b&gt;state geflusht&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="led"><mxGeometry x="20" y="108" width="400" height="38" as="geometry"/></mxCell>
<mxCell id="l3" value="offset 102 &amp;nbsp;·&amp;nbsp; venster eindigt 10:10 &amp;nbsp;·&amp;nbsp; &lt;b&gt;gefinaliseerd&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="led"><mxGeometry x="20" y="152" width="400" height="38" as="geometry"/></mxCell>
<mxCell id="l4" value="offset 103 &amp;nbsp;·&amp;nbsp; venster eindigt 10:15 &amp;nbsp;·&amp;nbsp; &lt;b&gt;nog open&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;align=left;spacingLeft=12;fontColor=#9a3b37;" vertex="1" parent="led"><mxGeometry x="20" y="196" width="400" height="38" as="geometry"/></mxCell>
<mxCell id="l5" value="offset 104 &amp;nbsp;·&amp;nbsp; venster eindigt 10:10 &amp;nbsp;·&amp;nbsp; gefinaliseerd&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;maar staat áchter 103 in de rij&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#8c8c8c;fontSize=11;align=left;spacingLeft=12;fontColor=#777777;dashed=1;" vertex="1" parent="led"><mxGeometry x="20" y="240" width="400" height="46" as="geometry"/></mxCell>
<mxCell id="lcommit" value="commit = 103&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;één voorbij het langste aaneengesloten begin&lt;br&gt;waarvan alle vensters gesloten zijn&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=3;fontSize=13;fontStyle=1;fontColor=#7a5c00;" vertex="1" parent="led"><mxGeometry x="20" y="300" width="400" height="70" as="geometry"/></mxCell>
<mxCell id="lnote" value="Zo lopen offsets nooit vóór op open vensters. Alles wat nog in een open venster zit wordt na een crash opnieuw geleverd en bouwt dat venster van voren af aan opnieuw op." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#8a6400;fontStyle=2;spacingLeft=6;" vertex="1" parent="led"><mxGeometry x="20" y="378" width="400" height="60" as="geometry"/></mxCell>
<mxCell id="crash" value="CRASH TUSSEN UPSERT EN COMMIT" style="swimlane;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;startSize=30;html=1;" vertex="1" parent="1"><mxGeometry x="920" y="100" width="360" height="450" as="geometry"/></mxCell>
<mxCell id="c1" value="venster 10:05–10:10 wordt geüpsert&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;count = 412&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" vertex="1" parent="crash"><mxGeometry x="20" y="42" width="320" height="52" as="geometry"/></mxCell>
<mxCell id="c2" value="proces valt om vóór de commit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontSize=11;fontStyle=1;" vertex="1" parent="crash"><mxGeometry x="20" y="104" width="320" height="46" as="geometry"/></mxCell>
<mxCell id="c3" value="broker levert dezelfde berichten opnieuw" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" vertex="1" parent="crash"><mxGeometry x="20" y="160" width="320" height="46" as="geometry"/></mxCell>
<mxCell id="c4" value="processor herberekent hetzelfde venster&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;dezelfde events → dezelfde count = 412&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" vertex="1" parent="crash"><mxGeometry x="20" y="216" width="320" height="52" as="geometry"/></mxCell>
<mxCell id="c5" value="UPSERT op&lt;br&gt;(window_start, dimension, dimension_id)&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;= de primary key&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=3;fontSize=11;fontStyle=1;fontColor=#5f3d73;" vertex="1" parent="crash"><mxGeometry x="20" y="278" width="320" height="66" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;één rij, identieke waarden&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;de tweede schrijfactie vervángt de eerste&lt;br&gt;in plaats van erbij op te tellen&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=3;fontSize=12;fontColor=#3d6b2e;" vertex="1" parent="crash"><mxGeometry x="20" y="354" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="extra1" value="&lt;b&gt;De watermark wordt bij het opstarten uit Postgres gezaaid&lt;/b&gt; — max(window_end) — zodat opnieuw geleverde berichten die bij een al weggeschreven venster horen als te laat gelden en worden genegeerd, in plaats van dat er een gedeeltelijk venster over een compleet venster heen wordt geschreven. Die seed wordt geklemd op de wandklok: één keer zaaide een replay die nog liep de watermark in de toekomst, waarna 130.000 goede events als te laat werden weggegooid." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="600" height="120" as="geometry"/></mxCell>
<mxCell id="extra2" value="&lt;b&gt;En er is een test die het bewijst.&lt;/b&gt; test_duplicate_delivery_does_not_double_count_in_real_postgres past hetzelfde gefinaliseerde venster twee keer toe tegen de echte database en controleert dat er één rij staat, met de oorspronkelijke count. Geen mock: de garantie die je claimt hoort de garantie te zijn die je test." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="680" y="580" width="600" height="120" as="geometry"/></mxCell>
