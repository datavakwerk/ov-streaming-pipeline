# --- Feed ------------------------------------------------------------------
OVAPI_BASE_URL=https://gtfs.ovapi.nl/nl
# Comma-separated operator codes (as found in GTFS-RT entity ids, e.g. NS,GVB,RET,HTM,ARR).
# Empty = nationwide, all operators.
OPERATOR_FILTER=
POSITIONS_POLL_INTERVAL_S=10
TRIP_UPDATES_POLL_INTERVAL_S=30

# --- Kafka (Redpanda) --------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092

# --- Postgres ----------------------------------------------------------------
# Host-side port (inside the compose network it is always 5432)
POSTGRES_HOST_PORT=5433
POSTGRES_USER=ov
POSTGRES_PASSWORD=ov
POSTGRES_DB=ov
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- MinIO -------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=raw-events
# Host-side ports (inside the compose network MinIO is always 9000/9001)
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011

# --- Processing --------------------------------------------------------------
WINDOW_SECONDS=300
ALLOWED_LATENESS_SECONDS=120

# --- Grafana -----------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
